# PropertySuite AI Operations — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit a real value,
# and never paste a secret into a chat transcript or a log line.
#
# Every variable below is read exactly once, through Zod validation, in lib/env.ts.
# The application fails fast at boot if a required value is missing or malformed.

# ---------------------------------------------------------------- Supabase -------
# Running the local stack (`npm run db:start`) prints all three of these. For a cloud
# project they are in Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses Row Level Security entirely. Never prefix with NEXT_PUBLIC_,
# never import outside a server-only module. CI fails the build if this string appears
# in the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------- AI ---------
# Provider-neutral adapter. Only `anthropic` is implemented in this build.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------- App ----------
APP_BASE_URL=http://localhost:3000

# =================================================================================
# LATER PHASE — not used in this build. Deliberately commented out: an unused secret
# in the environment is still a secret that can leak. See docs/requirements.md §4.
# =================================================================================
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
